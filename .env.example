# Variables d'environnement de UKit.
#
# Copier en `.env` (ignore par git) et renseigner. Les memes noms servent de secrets EAS pour les
# builds. Voir docs/backend.md.

# Rapport d'erreurs.
SENTRY_DSN=

# La base de publication (Blueprints, annonces, referentiels, catalogue des etablissements).
# La cle `anon` est publique par conception : elle est lisible dans n'importe quel binaire, et la
# frontiere de securite ce sont les politiques RLS (supabase/policies.sql).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Les deux valeurs qui suivent ne vont JAMAIS dans l'application : ni dans `extra`, ni dans un fichier
# versionne, ni dans un secret EAS. Elles vivent sur le poste du publieur et dans les secrets de CI.
# Qui les detient peut ecrire ce que tous les appareils liront.
#
# `service_role` : le script de publication des Blueprints (npm run blueprints:publish) et l'import
# de contenu (npm run content:import).
# SUPABASE_SERVICE_ROLE_KEY=
#
# Le mot de passe de la base : appliquer supabase/schema.sql et supabase/policies.sql avec psql.
# Voir supabase/README.md.
# SUPABASE_DB_PASSWORD=
