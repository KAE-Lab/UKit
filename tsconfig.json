{
  "compilerOptions": {
    // TypeScript 6 (exige par le SDK 57) passe `strict` a vrai par defaut. La politique du depot
    // reste celle de docs/qualite.md — la rigueur tient a la revue, pas au compilateur — et le mode
    // strict signale plus de deux cents sites, un chantier a part entiere. Ecrit ici pour que le
    // prochain TypeScript ne deplace pas la porte en silence.
    "strict": false
  },
  "extends": "expo/tsconfig.base",
  "exclude": ["node_modules", "babel.config.js", "metro.config.js", "jest.config.js", "android", "ios", "console", "supabase/functions/*/index.ts"]
}
