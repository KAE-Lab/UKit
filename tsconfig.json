{
  "compilerOptions": {
    // TypeScript 6 (exige par le SDK 57) passe `strict` a vrai par defaut. La politique du depot
    // reste celle de docs/qualite.md — la rigueur tient a la revue, pas au compilateur — et le mode
    // strict signale plus de deux cents sites, un chantier a part entiere. Ecrit ici pour que le
    // prochain TypeScript ne deplace pas la porte en silence.
    "strict": false
  },
  "extends": "expo/tsconfig.base",
  // `tools/epure/sortie/` porte les fichiers du labo, ignores par Git : en local, une erreur de
  // syntaxe y arretait `tsc` avant le controle des types du reste, que l'integration continue, qui
  // ne les a pas, voyait seule (cloture de 7-I).
  "exclude": ["node_modules", "babel.config.js", "metro.config.js", "jest.config.js", "android", "ios", "console", "supabase/functions/*/index.ts", "tools/epure/sortie"]
}
