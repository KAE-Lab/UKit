    "expo-web-browser": "~57.0.2",
    "html-entities": "^2.3.2",
    "ical.js": "^2.2.1",
    "moment": "^2.22.2",
    "prop-types": "^15.6.2",
    "react": "19.2.3",
    "react-native": "0.86.3",
