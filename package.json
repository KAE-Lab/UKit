    "commitizen": "^4.2.4",
    "cz-conventional-changelog": "^3.3.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.4.0",
    "husky": "^9.1.7",
    "pdfjs-dist": "6.3.289",
    "prettier": "^3.9.6",
    "qs": "^6.16.0",
