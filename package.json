{
  "name": "ukit",
  "version": "6.0.0",
  "description": "Ukit",
  "author": "KAELab",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build:android": "eas build -p android --profile preview",
    "build:ios": "eas build -p ios --profile preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "parity": "node tools/parity/run.mjs",
    "pdfjs:vendor": "node tools/pdfjs/vendor.mjs",
    "blueprints:publish": "node tools/publish-blueprints.mjs",
    "console:dev": "npm --prefix console run dev",
    "console:build": "npm --prefix console run build",
    "console:editeur": "node tools/console/editeur.mjs",
    "content:import": "node tools/import-ukit-data.mjs",
    "prepare": "husky",
    "commit": "cz"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "main": "node_modules/expo/AppEntry.js",
  "dependencies": {
