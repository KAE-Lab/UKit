    "expo-asset": "~57.0.16",
    "expo-background-task": "~57.0.16",
    "expo-blur": "~57.0.2",
    "expo-calendar": "~57.0.2",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.18",
